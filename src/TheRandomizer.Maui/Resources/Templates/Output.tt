<#@ template language="C#" visibility="internal" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="TheRandomizer.Enumerators" #>

<DOCTYPE html>
<html>
    <head>
        <meta charset='utf-8' />
        <style>
            <#= Style #>
			<#= CustomCSS #>
        </style>
    </head>
    <body>
		<#=
			Content.Format switch 
			{
				OutputFormats.Html => Content.Text,
				OutputFormats.Markdown => Utilities.MarkDigHelper.ToHtml(Content.Text),
				_ => $"<pre>{Content.Text}</pre>"
			}
		#>
    </body>
</html>